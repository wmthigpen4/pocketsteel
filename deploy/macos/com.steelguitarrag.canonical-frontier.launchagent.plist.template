<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.steelguitarrag.canonical-frontier</string>

  <key>WorkingDirectory</key>
  <string>__STEEL_RAG_CANONICAL_FRONTIER_SERVICE_ROOT__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__STEEL_RAG_CANONICAL_FRONTIER_WRAPPER__</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_SERVICE_ROOT</key>
    <string>__STEEL_RAG_CANONICAL_FRONTIER_SERVICE_ROOT__</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_MANIFEST</key>
    <string>__STEEL_RAG_CANONICAL_FRONTIER_MANIFEST__</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_PYTHON</key>
    <string>__STEEL_RAG_CANONICAL_FRONTIER_PYTHON__</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_ENV_FILE</key>
    <string>__STEEL_RAG_CANONICAL_FRONTIER_ENV_FILE__</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_VERIFIER</key>
    <string>__STEEL_RAG_CANONICAL_FRONTIER_VERIFIER__</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_HOST</key>
    <string>127.0.0.1</string>
    <key>STEEL_RAG_CANONICAL_FRONTIER_PORT</key>
    <string>8771</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>__STEEL_RAG_CANONICAL_FRONTIER_LOG_DIR__/canonical-frontier.out.log</string>

  <key>StandardErrorPath</key>
  <string>__STEEL_RAG_CANONICAL_FRONTIER_LOG_DIR__/canonical-frontier.err.log</string>

  <key>ThrottleInterval</key>
  <integer>10</integer>
</dict>
</plist>
